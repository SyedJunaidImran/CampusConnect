# ============================================================
# CampusConnect Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git!
# ============================================================

# MySQL Database
CAMPUS_DB_URL=jdbc:mysql://localhost:3306/campus_connect_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
CAMPUS_DB_USERNAME=root
CAMPUS_DB_PASSWORD=your_mysql_password_here

# JWT Secret Key (must be at least 32 characters / 256 bits)
# Generate one at: https://generate-random.org/api-key-generator
JWT_SECRET=YourSuperSecretJWTKeyThatIsAtLeast32CharactersLong2024

# JWT Token Expiration (in milliseconds) — default: 24 hours
JWT_EXPIRATION=86400000
