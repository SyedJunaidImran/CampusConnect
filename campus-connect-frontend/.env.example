# ============================================================
# CampusConnect Frontend — Environment Variables Template
# ============================================================
# Vite only exposes variables prefixed with VITE_ to the browser.
# For local development, copy this file to .env or .env.development.
# For production deployment, set VITE_API_URL in your hosting dashboard (e.g. Vercel).

# Backend API Base URL (including /api path)
VITE_API_URL=http://localhost:8080/api
